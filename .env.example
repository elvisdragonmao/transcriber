# Copy to .env (chmod 600). deploy/install.sh creates it with a random admin password.

# --- server -----------------------------------------------------------------
# keep loopback; Caddy terminates HTTPS in front
HOST=127.0.0.1
PORT=8000
PUBLIC_ORIGIN=https://whisper.elvismao.com
# ALLOWED_ORIGINS=             # extra origins allowed for CORS (default: PUBLIC_ORIGIN only)
# only the local reverse proxy may set X-Forwarded-For
TRUST_PROXY=127.0.0.1,::1
# refuse clients outside private / CGNAT (WARP) ranges
LAN_ONLY=1
DATA_DIR=/home/em/transcriber/data
LOG_LEVEL=info

# --- auth -------------------------------------------------------------------
ADMIN_USER=admin
# used only to create the first user; change later in the UI
ADMIN_PASSWORD=change-me

# --- AI worker --------------------------------------------------------------
# WORKER_PYTHON=/home/em/transcriber/worker/.venv/bin/python
# HF_HOME=/home/em/.cache/huggingface
# MOCK_WORKER=0                # 1 = fake worker for development without GPUs

# --- LLM CLIs (run as the service user, using their own login) --------------
# CLAUDE_BIN=/home/em/.local/bin/claude
# CODEX_BIN=/home/em/.npm-global/bin/codex

# --- Obsidian (LiveSync MCP on this host; tokens live in /opt/obsidian/.env) --
OBSIDIAN_MCP_URL=http://127.0.0.1:27123/mcp
OBSIDIAN_MCP_TOKEN=
OBSIDIAN_SEMANTIC_MCP_URL=http://127.0.0.1:27125/mcp
OBSIDIAN_SEMANTIC_MCP_TOKEN=
